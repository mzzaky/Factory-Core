[B][SIZE=6][COLOR=#2ECC71]▐[/COLOR] [COLOR=#ECFDF5]COMMANDS[/COLOR][/SIZE][/B]

[SIZE=4][COLOR=#2ECC71]▸[/COLOR] [B][COLOR=#A9DFBF]Player Commands[/COLOR][/B][/SIZE]
[CODE]
/fc hub              — Open the main hub menu
/fc browse           — Browse available factories
/fc myfactories      — View your owned factories
/fc buy <id>         — Purchase a factory
/fc sell <id>        — Sell a factory
/fc info <id>        — View factory details
/fc teleport <id>    — Fast travel to your factory
/fc gui <id>         — Open factory control panel
/fc marketplace      — Open the global marketplace
/fc invoices         — View your invoices
/fc taxes            — Open tax center
/fc employees        — Open employee shop
/fc dailyquest       — View daily quests
/fc help             — In-game help menu
/fc version          — Plugin version
[/CODE]

[SIZE=4][COLOR=#2ECC71]▸[/COLOR] [B][COLOR=#A9DFBF]Admin Commands[/COLOR][/B][/SIZE]
[CODE]
/fc admin create <region> <type> <id> <price>  — Create a factory
/fc admin remove <id>                          — Delete a factory
/fc admin list                                 — List all factories
/fc admin info <id>                            — View factory info
/fc admin reload                               — Reload all configs
/fc admin setowner <id> <player>               — Transfer ownership
/fc admin teleport <id>                        — Teleport to factory
/fc admin give <resource> <amount> <player>    — Give resources
/fc admin npc spawn|remove <id>                — Manage NPCs
[/CODE]

[SIZE=5][COLOR=#95A5A6]━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━[/COLOR][/SIZE]

