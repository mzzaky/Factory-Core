[SIZE=5][COLOR=#95A5A6]━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━[/COLOR][/SIZE]
[SIZE=4][COLOR=#BDC3C7]The Ultimate Industrial Economy Plugin for Minecraft[/COLOR][/SIZE]
[SIZE=3][COLOR=#7F8C8D]Version 1.2.5 | Minecraft 1.21+ | Java 17+[/COLOR][/SIZE]

[SIZE=5][COLOR=#95A5A6]━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━[/COLOR][/SIZE]

[B][SIZE=6][COLOR=#2ECC71]▐[/COLOR] [COLOR=#ECFDF5]OVERVIEW[/COLOR][/SIZE][/B]
[SIZE=3][COLOR=#D5F5E3]Transform your Minecraft server into a thriving industrial economy.
FactoryCore introduces a fully-fledged factory management system where players
build, upgrade, and manage factories — hire NPC employees, research new technologies,
complete daily quests, trade on a global marketplace, and much more.

Whether you run a survival, economy, or RPG server, FactoryCore adds unparalleled
depth and endless engagement for your community.[/COLOR][/SIZE]

[SIZE=5][COLOR=#95A5A6]━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━[/COLOR][/SIZE]

[B][SIZE=6][COLOR=#2ECC71]▐[/COLOR] [COLOR=#ECFDF5]KEY FEATURES[/COLOR][/SIZE][/B]

[SIZE=4][COLOR=#2ECC71]◆[/COLOR] [B][COLOR=#A9DFBF]5 Unique Factory Types[/COLOR][/B][/SIZE]
[LIST]
[*][COLOR=#D5F5E3][B]Smeltery[/B] — Convert raw vanilla ores into tracked resources[/COLOR]
[*][COLOR=#D5F5E3][B]Steel Mill[/B] — Transform raw materials into advanced alloys[/COLOR]
[*][COLOR=#D5F5E3][B]Refinery[/B] — Produce essential fuel for all operations[/COLOR]
[*][COLOR=#D5F5E3][B]Workshop[/B] — Craft machine parts consumed by every factory[/COLOR]
[*][COLOR=#D5F5E3][B]Advanced Factory[/B] — Manufacture high-value finished goods[/COLOR]
[/LIST]

[SIZE=4][COLOR=#2ECC71]◆[/COLOR] [B][COLOR=#A9DFBF]Deep Production System[/COLOR][/B][/SIZE]
[LIST]
[*][COLOR=#D5F5E3]20+ production recipes with realistic input/output chains[/COLOR]
[*][COLOR=#D5F5E3]Queue up to 5 concurrent productions per factory[/COLOR]
[*][COLOR=#D5F5E3]Real-time BossBar progress tracking[/COLOR]
[*][COLOR=#D5F5E3]5-level factory upgrade system with time & cost bonuses[/COLOR]
[/LIST]

[SIZE=4][COLOR=#2ECC71]◆[/COLOR] [B][COLOR=#A9DFBF]Living Economy[/COLOR][/B][/SIZE]
[LIST]
[*][COLOR=#D5F5E3]Vault-integrated tax & salary system with invoices[/COLOR]
[*][COLOR=#D5F5E3]Global marketplace — player-to-player trading with tax rates[/COLOR]
[*][COLOR=#D5F5E3]Dynamic factory buy/sell system with value scaling[/COLOR]
[*][COLOR=#D5F5E3]Late fees & overdue invoice penalties[/COLOR]
[/LIST]

[SIZE=4][COLOR=#2ECC71]◆[/COLOR] [B][COLOR=#A9DFBF]NPC Employee System[/COLOR][/B][/SIZE]
[LIST]
[*][COLOR=#D5F5E3]8+ hireable NPC types with unique production buffs[/COLOR]
[*][COLOR=#D5F5E3]Animated employees with idle movements & head tracking[/COLOR]
[*][COLOR=#D5F5E3]Salary costs to maintain economic balance[/COLOR]
[*][COLOR=#D5F5E3]Custom appearances, equipment, and ambient sounds[/COLOR]
[/LIST]

[SIZE=4][COLOR=#2ECC71]◆[/COLOR] [B][COLOR=#A9DFBF]Research & Progression[/COLOR][/B][/SIZE]
[LIST]
[*][COLOR=#D5F5E3]4+ tech trees with 5 levels each[/COLOR]
[*][COLOR=#D5F5E3]Permanent buffs: Fiscal Optimization, AI Workforce, Nano-Construction & more[/COLOR]
[*][COLOR=#D5F5E3]Strategic long-term investments for competitive advantage[/COLOR]
[/LIST]

[SIZE=4][COLOR=#2ECC71]◆[/COLOR] [B][COLOR=#A9DFBF]Achievements & Daily Quests[/COLOR][/B][/SIZE]
[LIST]
[*][COLOR=#D5F5E3]15+ trackable achievements with toast notifications[/COLOR]
[*][COLOR=#D5F5E3]5 daily quests that refresh automatically[/COLOR]
[*][COLOR=#D5F5E3]EXP & money rewards with all-complete bonuses[/COLOR]
[/LIST]

[SIZE=4][COLOR=#2ECC71]◆[/COLOR] [B][COLOR=#A9DFBF]Player-Created Factories[/COLOR][/B][/SIZE]
[LIST]
[*][COLOR=#D5F5E3]Players can create their own factory regions — no WorldGuard required![/COLOR]
[*][COLOR=#D5F5E3]Automatic border particle visualization[/COLOR]
[*][COLOR=#D5F5E3]Built-in region protection system[/COLOR]
[/LIST]

