[SIZE=5][COLOR=#95A5A6]━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━[/COLOR][/SIZE]

[B][SIZE=6][COLOR=#2ECC71]▐[/COLOR] [COLOR=#ECFDF5]CONFIGURATION[/COLOR][/SIZE][/B]

[SIZE=3][COLOR=#D5F5E3]FactoryCore is [B]fully configurable[/B] through clean, well-documented YAML files.
Customize every aspect of the plugin to perfectly fit your server's needs.[/COLOR][/SIZE]

[LIST]
[*][COLOR=#A9DFBF][B]config.yml[/B] — Core settings: database, tax rates, marketplace, notifications[/COLOR]
[*][COLOR=#A9DFBF][B]resources.yml[/B] — Define 30+ resource items with custom models & lore[/COLOR]
[*][COLOR=#A9DFBF][B]recipes.yml[/B] — Create & modify 20+ production recipes[/COLOR]
[*][COLOR=#A9DFBF][B]language.yml[/B] — Full localization support[/COLOR]
[*][COLOR=#A9DFBF][B]npc.yml[/B] — Configure NPC types, buffs, appearances & pricing[/COLOR]
[*][COLOR=#A9DFBF][B]research.yml[/B] — Design tech trees with custom costs & durations[/COLOR]
[*][COLOR=#A9DFBF][B]achievement.yml[/B] — Define achievements with custom thresholds[/COLOR]
[*][COLOR=#A9DFBF][B]daily-quest.yml[/B] — Set up daily quests with custom rewards[/COLOR]
[*][COLOR=#A9DFBF][B]custom_gui/[/B] — Fully customizable main hub menu layout[/COLOR]
[/LIST]

[SIZE=5][COLOR=#95A5A6]━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━[/COLOR][/SIZE]

[B][SIZE=6][COLOR=#2ECC71]▐[/COLOR] [COLOR=#ECFDF5]DEVELOPER API[/COLOR][/SIZE][/B]

[SIZE=3][COLOR=#D5F5E3]FactoryCore provides a clean [B]public API[/B] with [B]15+ methods[/B] for developers
who want to integrate with FactoryCore in their own plugins.[/COLOR][/SIZE]

[CODE]
FactoryCoreAPI api = FactoryCoreAPI.getInstance();

// Get player's factories
List<Factory> factories = api.getPlayerFactories(player);

// Check factory status, start production, and more!
[/CODE]

[SIZE=5][COLOR=#95A5A6]━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━[/COLOR][/SIZE]

[B][SIZE=6][COLOR=#2ECC71]▐[/COLOR] [COLOR=#ECFDF5]WHY FACTORYCORE?[/COLOR][/SIZE][/B]

[SIZE=4]
[COLOR=#2ECC71]✔[/COLOR] [COLOR=#D5F5E3][B]Unmatched Depth[/B] — 68 Java classes, 13 manager systems, thousands of lines of polished code[/COLOR]
[COLOR=#2ECC71]✔[/COLOR] [COLOR=#D5F5E3][B]Player Retention[/B] — Daily quests, achievements, and progression keep players coming back[/COLOR]
[COLOR=#2ECC71]✔[/COLOR] [COLOR=#D5F5E3][B]Balanced Economy[/B] — Built-in tax, salary, and marketplace systems prevent inflation[/COLOR]
[COLOR=#2ECC71]✔[/COLOR] [COLOR=#D5F5E3][B]Zero Learning Curve[/B] — 25 intuitive GUIs mean players never need to type a command[/COLOR]
[COLOR=#2ECC71]✔[/COLOR] [COLOR=#D5F5E3][B]Highly Configurable[/B] — 9 YAML config files let you customize every detail[/COLOR]
[COLOR=#2ECC71]✔[/COLOR] [COLOR=#D5F5E3][B]Extensible[/B] — Public API + PlaceholderAPI + MMOItems + ExecutableItems support[/COLOR]
[COLOR=#2ECC71]✔[/COLOR] [COLOR=#D5F5E3][B]Lightweight[/B] — Efficient schedulers and YAML-based storage with no database required[/COLOR]
[COLOR=#2ECC71]✔[/COLOR] [COLOR=#D5F5E3][B]Active Development[/B] — Regular updates and dedicated support[/COLOR]
[/SIZE]

[SIZE=5][COLOR=#95A5A6]━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━[/COLOR][/SIZE]

[B][SIZE=6][COLOR=#2ECC71]▐[/COLOR] [COLOR=#ECFDF5]INSTALLATION[/COLOR][/SIZE][/B]

[SIZE=3]
[COLOR=#2ECC71]①[/COLOR] [COLOR=#D5F5E3]Download [B]FactoryCore.jar[/B] and place it in your [B]/plugins[/B] folder[/COLOR]
[COLOR=#2ECC71]②[/COLOR] [COLOR=#D5F5E3]Ensure [B]Vault[/B], [B]WorldGuard[/B], and [B]WorldEdit[/B] are installed[/COLOR]
[COLOR=#2ECC71]③[/COLOR] [COLOR=#D5F5E3]Start your server — default configs will be generated automatically[/COLOR]
[COLOR=#2ECC71]④[/COLOR] [COLOR=#D5F5E3]Customize configs in [B]/plugins/FactoryCore/[/B] to match your server[/COLOR]
[COLOR=#2ECC71]⑤[/COLOR] [COLOR=#D5F5E3]Use [B]/fc admin create[/B] to set up your first factory — you're ready![/COLOR]
[/SIZE]

[SIZE=5][COLOR=#95A5A6]━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━[/COLOR][/SIZE]

